# 12-Factor App - Factor III: Config lives in the ENVIRONMENT, not in the code.
# Copy to .env (which is git-ignored) and fill in real values:
#   cp .env.example .env
# Same artifact, different .env per environment (dev / staging / prod).

APP_ENV=development
PORT=3000
LOG_LEVEL=info

# Factor IV: backing services are just URLs - swap them without code changes
DATABASE_URL=postgres://app:CHANGE_ME@localhost:5432/appdb
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
KAFKA_BROKERS=localhost:9092

# Secrets: in production these come from a secret manager
# (AWS Secrets Manager, Vault, Kubernetes Secrets) - never commit real values.
JWT_SECRET=CHANGE_ME
